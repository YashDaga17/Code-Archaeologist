# ═══════════════════════════════════════════════════════════════
# CODE ARCHAEOLOGIST — Comprehensive Git Ignore Rules
# ═══════════════════════════════════════════════════════════════

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
backend/node_modules

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage
*.lcov
.nyc_output
.playwright-cli/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!.env.template
!backend/.env.example
!backend/.env.template

# Cloud Provider & Workspace Credentials
.databrickscfg
*service-account*.json
*credentials*.json
gcp-key*.json
aws/credentials
aws/config

# Private Keys, Certificates, and SSH Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
id_ecdsa*
id_ed25519*
*.pub

# Database Dumps & Local Storage
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
entire-debug.log*
*.log
core.*
*.stackdump

# Vercel & Cloud Deployments
.vercel

# TypeScript & Compilation Cache
*.tsbuildinfo
next-env.d.ts

# IDE & Editor Local Configurations
.vscode/*.local.json
.idea/workspace.xml
.idea/shelf/
.idea/**/tasks.xml

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary Folders & Scratch Data
/temp/
/scratch/
*.tmp
*.bak
